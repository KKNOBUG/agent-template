# ---- 切分策略 ----
# PDF 切分阈值（超过此页数的PDF会被切分成多个子文档）
PDF_SPLIT_MAX_PAGES=20
# 分片解析最大并行数
MAX_PARALLEL_PARSE_DOCLING=3

# ---- docling 解析 ----
# PDF 内存后端：pypdfium2（内存高效，适合处理大文档）/ docling_parse（默认）
DOCLING_PDF_BACKEND=pypdfium2
# docling 是否用 GPU：true = CUDA，false = 纯 CPU（无 NVIDIA GPU 或未装 CUDA 版 torch 须置 false）
DOCLING_USE_GPU=false

# ---- 文件存储路径 ----
# 框架输出根目录（日志等子目录锚定于此）
OUTPUT_DIR=./output
# PDF文件转换输出目录
RAG_OUTPUT_DIR=./output/rag_upload

# ---- 术语提取 ----
# 术语提取时 LLM 调用的并行数
TERMINOLOGY_BATCH_CONCURRENCY=5

# ---- 分块参数 ----
# 每个分块的目标 token 数
CHUNK_SIZE=800
# 相邻分块之间的重叠 token 数
CHUNK_OVERLAP_SIZE=100

# ---- VLM 多模态分析 ----
# 是否启用 VLM 多模态分析（需要 vision-capable 模型）
ENABLE_VLM=false
# VLM API 地址
VLM_API_BASE=https://api.openai.com/v1
# VLM API Key
VLM_API_KEY=your-api-key
# VLM 模型名称
VLM_MODEL=gpt-4o

# ---- 向量嵌入 ----
# 嵌入 API 地址
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
# 嵌入 API Key
EMBEDDING_BINDING_API_KEY=your-api-key
# 嵌入模型名称
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度
EMBEDDING_DIM=1024
# 嵌入批次大小
EMBEDDING_BATCH_NUM=100
# 嵌入 API 最大并发请求数（批次增大后总请求数减少, 适当放宽并发不会加剧限流）
EMBEDDING_MAX_CONCURRENT=10
# 嵌入输入单条文本的字符上限（需覆盖最大分块长度）
EMBEDDING_MAX_CHARS_PER_TEXT=5000
# 是否在请求中发送 dimensions 参数
EMBEDDING_SEND_DIM=false
# 是否使用 base64 编码
EMBEDDING_USE_BASE64=true

# ---- LLM ----
# LLM API 地址
LLM_API_BASE=https://api.deepseek.com/v1
# LLM API Key
LLM_API_KEY=your-api-key
# LLM 模型名称
LLM_MODEL=deepseek-chat
# LLM 最大输出 token 数
LLM_MAX_TOKENS=4096
# LLM 温度
LLM_TEMPERATURE=0.7
# 上下文窗口上限
MAX_TOTAL_TOKENS=1000000
# 向量检索(naive 模式)稠密检索返回的分块条数
CHUNK_TOP_K=100
# 混合检索(hybrid 模式) RRF 融合保留条数（重排候选池）
RRF_TOP_K=100
# 混合检索每通道候选数（改写查询一路 dense + 一路 BM25，UI 显式传值时优先 UI）
HYBRID_DENSE_TOP_K=100
HYBRID_BM25_TOP_K=100

# ---- 重排序 ----
# 重排序 API 地址
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
# 重排序 API Key
RERANK_BINDING_API_KEY=your-api-key
# 重排序模型名称
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 是否启用文档分块重排序（长文档先分块再聚合）
RERANK_ENABLE_CHUNKING=true
# 每个文档的最大 token 数（用于分块重排序）
RERANK_MAX_TOKENS_PER_DOC=2048
# 重排后最多返回的分块数（最终检索窗口, 从候选池中精选）
RERANK_TOP_K=50
# 最小重排序分数阈值（低于此分数的 chunk 会被过滤）
RERANK_MIN_SCORE=0.92
# 最终检索窗口中单个文档可占的 token 预算比例上限（多文档联合检索保障; 1.0 = 关闭封顶）
DOC_BUDGET_MAX_SHARE=0.6

# ---- 文档级召回（文档摘要索引 + 定向注入, 多文档联合检索召回增强）----
# 是否启用文档级召回（摘要索引匹配 → 命中文档定向取分块, 作为一路进 RRF 候选池;
# 只放宽召回, 进窗口仍由 rerank RERANK_MIN_SCORE 唯一裁决）
DOC_RECALL_ENABLED=true
# 查询向量与文档摘要向量的最低余弦相似度（达标才定向取该文档分块）
DOC_RECALL_MIN_SCORE=0.5
# 每份命中文档定向检索的分块数
DOC_RECALL_CHUNKS_PER_DOC=8
# 单次查询最多命中的文档数
DOC_RECALL_MAX_DOCS=3
# 文档摘要索引缓存 TTL（秒; 另有文档表指纹二级判据, 文档增删/重跑即重建）
DOC_RECALL_INDEX_TTL=30.0
# 摘要生成的输入字符上限（头部 80% + 尾部 20% 截断后送 LLM）
DOC_SUMMARY_INPUT_MAX_CHARS=20000

# ---- 子查询分解（复合问题拆为单面查询, 每面独立召回）----
# 是否启用子查询分解（单一面问题原样通过; 判定/解析/超时一律回退为不分解）
SUBQUERY_DECOMPOSE_ENABLED=true
# 分解出的子查询数量上限
SUBQUERY_MAX_COUNT=4

# ---- 向量数据库 ----
# 后端选择: chromadb | milvus（默认为本地milvus-lite）
VECTOR_BACKEND=milvus
# Milvus 远程连接（http://host:19530），本地 Milvus Lite 时保持注释
# MILVUS_URI=./.milvus.db
# MILVUS_USER=
# MILVUS_PASSWORD=

# ====== JWT 鉴权 ======
# 长度至少 64 位，建议: openssl rand -hex 32
AUTH_SECRET_KEY=your-64+char-secret

# ---- MySQL 数据库（必填, 缺失任一项应用启动即报错）----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=your_db_name
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
# 开发环境启动时自动执行 aerich 迁移建表（生产 Linux 恒为自动迁移）
DATABASE_AUTO_MIGRATION=true

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
